# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: encrypts stored provider keys. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LUMEN_SECRET_KEY=

# Optional: where uploads, audio and the settings key live (default ./storage)
LUMEN_STORAGE_DIR=

# Optional hard upper bound for parallel model writers (leave blank to use the 2–4 setting in the app)
# Ollama is always capped to one worker regardless of this value.
LUMEN_SCENE_CONCURRENCY=

# Optional: max upload size in bytes (default 150 MB)
LUMEN_MAX_UPLOAD_BYTES=157286400

# Optional: allow loopback/private LAN addresses for LLM/TTS/Embedding providers (e.g. Ollama on localhost)
LUMEN_ALLOW_LOCAL_PROVIDERS=1

# Optional: gate the whole UI and API behind an access code (signed HttpOnly cookie)
ACCESS_CODE=
